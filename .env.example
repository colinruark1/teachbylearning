# Copy to .env.local for `vercel dev`; set the same vars in Vercel → Settings → Environment Variables.
BETTER_AUTH_SECRET=   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000   # your deployed origin in production, e.g. https://your-app.vercel.app
DATABASE_URL=postgres://user:pass@host:5432/dbname   # Neon / Vercel Postgres / Supabase etc.

# Messaging: which service reaches people (see lib/messaging/index.js to add or swap one).
PHONE_PROVIDER=          # bird-whatsapp | log | none (default: bird-whatsapp if BIRD_API_KEY is set; log = print, code 000000)
EMAIL_PROVIDER=          # log | none (default: none)

# Phone provider "bird-whatsapp": WhatsApp via Bird. https://bird.com/docs/guides/whatsapp/overview
BIRD_API_KEY=            # bk_us1_… from bird.com/dashboard/w/api-keys (region comes from the prefix)
BIRD_WHATSAPP_NUMBER=    # your WhatsApp business number on Bird, E.164, e.g. +15551234567
BIRD_WEBHOOK_SECRET=     # whsec_… printed by `npm run messaging:webhook` (production only)
BIRD_TEMPLATE_SLUG=      # approved Utility template with a {{reminder}} variable, for users outside the 24 h window
BIRD_TEMPLATE_LANGUAGE=  # optional, default en
BIRD_VERIFY_CHANNELS=    # optional, default whatsapp (e.g. whatsapp,sms to fall back to SMS)

# File storage (check-in photos). See lib/storage/index.js to add or swap a provider.
STORAGE_PROVIDER=          # supabase | postgres (default: supabase when the two vars below are set, else postgres)
SUPABASE_URL=              # https://<project-ref>.supabase.co (Supabase → Connect, or Settings → API Keys)
SUPABASE_SERVICE_ROLE_KEY= # secret key sb_secret_… (or legacy service_role eyJ…). SERVER ONLY, never in browser code
SUPABASE_STORAGE_BUCKET=   # optional, default proof-photos (created by `npm run storage:setup`)

# Strava (Fitness community: attach runs/rides to progress posts). Create the app at
# https://www.strava.com/settings/api; set its Authorization Callback Domain to your host
# (e.g. your-app.vercel.app; localhost always works). Redirect URI: <BETTER_AUTH_URL>/api/strava/callback
STRAVA_CLIENT_ID=        # numeric Client ID
STRAVA_CLIENT_SECRET=    # Client Secret. SERVER ONLY
STRAVA_VERIFY_TOKEN=     # openssl rand -hex 16; checked when `npm run strava:webhook` subscribes
STRAVA_SUBSCRIPTION_ID=  # printed by `npm run strava:webhook` (production only)

CRON_SECRET=           # openssl rand -hex 24; the scheduler sends it to POST /api/reminders
ADMIN_EMAILS=          # optional, comma-separated; defaults to colinruark1@gmail.com
